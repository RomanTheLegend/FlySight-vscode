{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        },




        {
            "name": "Debug (OpenOCD + ST-Link)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
 
            // Path to your compiled ELF — adjust if your CMake output dir differs
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
 
            // ST-Link + STM32WB5M target config
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32wbx.cfg"
            ],
 
            // Optional: path to openocd if not on PATH
            // "serverpath": "/usr/local/bin/openocd",
 
            // arm-none-eabi-gdb — adjust path if needed
            "armToolchainPath": "/usr/bin",
            "gdbPath": "arm-none-eabi-gdb",
 
            // SVD file enables peripheral register inspection in the PERIPHERALS panel
            // Download from: https://github.com/posborne/cmsis-svd/tree/master/data/STMicro
            "svdFile": "${workspaceFolder}/STM32WB5M.svd",
 
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none",
 
            "preLaunchTask": "Build (CMake)",
 
            "openOCDLaunchCommands": [
                // Hard-reset and halt before flashing
                "reset_config srst_only srst_nogate",
                "reset halt"
            ],
 
            "postLaunchCommands": [
                // Load symbols and reset to entry point
                "monitor reset halt"
            ]
        },
 
        {
            "name": "Attach (OpenOCD + ST-Link)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
 
            "executable": "${workspaceFolder}/build/Debug/${workspaceFolderBasename}.elf",
 
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32wbx.cfg"
            ],
 
            "gdbPath": "arm-none-eabi-gdb",
            "svdFile": "${workspaceFolder}/STM32WB5M.svd",
            "showDevDebugOutput": "raw", 

            "openOCDLaunchCommands": [
                "adapter speed 200",
                "reset_config srst_only"
            ]
        }

    ]
}